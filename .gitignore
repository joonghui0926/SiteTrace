# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local references, generated files, and Python artifacts
/.reference-video-context-graph/
/.dev-server.*.log
/backend/.venv/
/backend/.pytest_cache/
/backend/**/__pycache__/
/backend/.sitetrace/
/.sitetrace/
*.egg-info/
/backend/uploads/
/backend/generated/
/output/
/tmp/

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/.amplify-wrangler.json
/worker-configuration.d.ts
