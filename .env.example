# Public web configuration
NEXT_PUBLIC_SITETRACE_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_NORMALIZATION_MODEL=gpt-5.6-luna
OPENAI_REASONING_MODEL=gpt-5.6-terra
OPENAI_ESCALATION_MODEL=gpt-5.6-sol

# TwelveLabs Jockey / Knowledge Store
TWELVE_LABS_API_KEY=
TWELVE_LABS_KNOWLEDGE_STORE_ID=

# Neo4j AuraDB on AWS
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# AWS runtime and storage
AWS_REGION=us-east-1
SITETRACE_S3_BUCKET=
SITETRACE_SESSION_TABLE=

# Local-only development
SITETRACE_DEMO_MODE=true
